{
  "manifest_version": 3,
  "name": "IndianVisaBuzz Automator",
  "version": "1.0.0",
  "description": "Automate Indian Visa application steps with one click.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://*.ivacbd.com/*",
    "https://*.indianvisaonline.gov.in/*",
    "https://*.vercel.app/*",
    "http://localhost:3000/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://*.ivacbd.com/*",
        "https://*.indianvisaonline.gov.in/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"]
    }
  ],
  "action": {
    "default_title": "IndianVisaBuzz"
  }
}
