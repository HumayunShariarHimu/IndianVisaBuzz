{
  "manifest_version": 3,
  "name": "IndianVisaBuzz — Visa Preparation Assistant",
  "version": "2.0.2",
  "description": "Helps prepare applicant form fields and attach PDF files on official visa portals. You review and submit every step.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://appointment.ivacbd.com/*",
    "https://indianvisaonline.gov.in/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": [
      "https://appointment.ivacbd.com/*",
      "https://indianvisaonline.gov.in/*"
    ],
    "js": ["file-upload.js", "content.js"],
    "css": ["style.css"],
    "run_at": "document_idle"
  }],
  "action": { "default_title": "Open IndianVisaBuzz assistant" }
}
